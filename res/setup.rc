/* PhotoCraft Classic main executable resources (no visual-styles manifest on
 * purpose: Windows XP-10 then draw standard controls in the classic 3D look). */
#include <winver.h>
1 ICON "setup.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION PC_VERSION_NUM
PRODUCTVERSION PC_VERSION_NUM
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "PhotoCraft Classic contributors\0"
      VALUE "FileDescription", "PhotoCraft Classic setup\0"
      VALUE "FileVersion", PC_VERSION_STR
      VALUE "InternalName", "Setup\0"
      VALUE "LegalCopyright", "MIT OR Apache-2.0. Based on PhotoCraft.\0"
      VALUE "OriginalFilename", "Setup.exe\0"
      VALUE "ProductName", "PhotoCraft Classic\0"
      VALUE "ProductVersion", PC_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
